{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_CLEARTEXT_HTTP": "1",
        "CMAKE_BUILD_PARALLEL_LEVEL": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "CMAKE_BUILD_PARALLEL_LEVEL": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "internal": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "CMAKE_BUILD_PARALLEL_LEVEL": "1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "CMAKE_BUILD_PARALLEL_LEVEL": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
